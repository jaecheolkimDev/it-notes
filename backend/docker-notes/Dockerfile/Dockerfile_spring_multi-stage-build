# 매번 로컬에서 빌드한 뒤 파일을 옮기는 것이 번거롭다면, Dockerfile 안에서 직접 빌드까지 수행하도록 만드는 멀티 스테이지 빌드 방식을 추천합니다.
# 이 방식을 사용하면 로컬에 JDK가 설치되어 있지 않아도 Docker만으로 빌드부터 실행까지 가능합니다.

# 1단계: 빌드 환경
FROM openjdk:17-jdk AS build
WORKDIR /app
COPY . .
RUN ./gradlew build -x test

# 2단계: 실행 환경
FROM openjdk:17-jdk
COPY --from=build /app/build/libs/*SNAPSHOT.jar app.jar
ENTRYPOINT ["java", "-jar", "/app.jar"]